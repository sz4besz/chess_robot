<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chess_robot</name>
  <version>0.0.0</version>
  <description>Chess-playing robot using image recognition and UR3 robot</description>
  <maintainer email="mates@todo.todo">mates</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <!-- Robot control dependencies -->
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>ur_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  
  <!-- MoveIt dependencies -->
  <depend>eigen</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>geometric_shapes</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>moveit_msgs</depend>
  
  <!-- Image processing dependencies -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>image_view</depend>

  <depend>std_srvs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
